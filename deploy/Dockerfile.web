FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.26.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY artifacts/btc-market-console/package.json artifacts/btc-market-console/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
RUN pnpm install --frozen-lockfile

COPY artifacts/btc-market-console artifacts/btc-market-console
COPY lib/api-client-react lib/api-client-react
COPY lib/api-zod lib/api-zod
RUN PORT=22111 BASE_PATH=/ pnpm --filter @workspace/btc-market-console run build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/artifacts/btc-market-console/dist/public /usr/share/nginx/html

EXPOSE 80